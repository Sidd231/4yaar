APP_PORT=8080
APP_ENV=development
JWT_SECRET=your-super-secret-key-at-least
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=a-secure-bootstrap-password

# Either provide individual DB settings or a unified DATABASE_URL (common on Render / Neon / Supabase):
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=4yaar
DB_SSLMODE=disable

REDIS_URL=redis://localhost:6379

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
S3_BUCKET=4yaar-files
SES_FROM_EMAIL=noreply@yourdomain.com
APP_BASE_URL=http://localhost:8080

